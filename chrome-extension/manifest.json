{
  "manifest_version": 3,
  "name": "Getto — Kirim ke Download Manager",
  "version": "1.0.0",
  "key": "",
  "description": "Kirim link & video langsung ke aplikasi Getto di macOS.",
  "permissions": [
    "contextMenus",
    "downloads",
    "activeTab",
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kirim ke Getto"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.tiktok.com/*",
        "*://www.instagram.com/*",
        "*://twitter.com/*",
        "*://x.com/*",
        "*://www.facebook.com/*",
        "*://vimeo.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
